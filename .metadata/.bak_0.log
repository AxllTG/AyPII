		PositionalList<String> pl = new LinkedPositionalList<String>();
		Position<String> p;

		pl.addLast("Ana");
		p = pl.addLast("Juan");
		pl.addLast("Omar");
		pl.addLast("Maria");

		pl.addBefore(p, "Samuel");
		pl.addAfter(p, "Pedro");

		pl.set(p, "Luis");

		String s;
		Iterator<String> i = pl.iterator();
		while (i.hasNext()) {
			s = i.next();
			if (s.equals("Juan"))
				i.remove();
		}
		for (String t : pl)
			System.out.println(t);
		
		if(isPalindrome())
			System.out.println("Es palindromo.");

	}
	
